<?xml version="1.0" encoding="utf-8"?>
<klayout-macro>
 <description>KlayoutClaw MCP Server</description>
 <version>0.6</version>
 <category>pymacros</category>
 <prolog/>
 <epilog/>
 <doc/>
 <autorun>true</autorun>
 <autorun-early>false</autorun-early>
 <priority>0</priority>
 <shortcut/>
 <show-in-menu>false</show-in-menu>
 <group-name/>
 <menu-path/>
 <interpreter>python</interpreter>
 <dsl-interpreter-name/>
 <text>
import sys
import os
import io
import tempfile

# KLayout GUI app has no terminal — sys.stdout defaults to ASCII encoding.
# Reconfigure to UTF-8 so print() won't crash on non-ASCII characters.
if hasattr(sys.stdout, 'buffer'):
    sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding='utf-8', errors='replace')
if hasattr(sys.stderr, 'buffer'):
    sys.stderr = io.TextIOWrapper(sys.stderr.buffer, encoding='utf-8', errors='replace')

# Early log to verify macro execution
_early_log = os.path.expanduser("~/.klayout/klayoutclaw.log")
with open(_early_log, "a") as _f:
    _f.write("MACRO STARTED (v0.6 QTcpServer)\n")

try:
    import pya
    with open(_early_log, "a") as _f:
        _f.write("PYA IMPORTED\n")
except Exception as _e:
    with open(_early_log, "a") as _f:
        _f.write("PYA IMPORT FAILED: {}\n".format(_e))

import json
import re
import uuid
import datetime
import traceback as _tb_mod

with open(_early_log, "a") as _f:
    _f.write("ALL IMPORTS OK\n")

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

_log_path = os.path.expanduser("~/.klayout/klayoutclaw.log")


def _log(msg):
    ts = datetime.datetime.now().isoformat()
    line = "[{}] {}".format(ts, msg)
    try:
        with open(_log_path, "a", encoding="utf-8") as f:
            f.write(line + "\n")
    except Exception:
        pass
    try:
        print("[KlayoutClaw] " + msg)
    except (UnicodeEncodeError, UnicodeDecodeError):
        print("[KlayoutClaw] " + msg.encode('ascii', errors='replace').decode('ascii'))
    try:
        if "_klayoutclaw" in sys.modules:
            cb = sys.modules["_klayoutclaw"]
            if msg.startswith("ERROR") and getattr(cb, "on_error", None):
                cb.on_error(msg)
    except Exception:
        pass


# ---------------------------------------------------------------------------
# UI callback slots (shared via sys.modules["_klayoutclaw"])
# ---------------------------------------------------------------------------

import types as _types
if "_klayoutclaw" not in sys.modules:
    _claw_cb = _types.ModuleType("_klayoutclaw")
    _claw_cb.on_request = None       # fn(method, timestamp, success, error_msg)
    _claw_cb.on_server_start = None  # fn(port)
    _claw_cb.on_error = None         # fn(error_msg)
    _claw_cb.server_port = None      # int, set when server starts
    sys.modules["_klayoutclaw"] = _claw_cb


def _notify_request(method, success, error_msg=None):
    """Notify UI of a request (no-op if UI not loaded)."""
    try:
        cb = sys.modules.get("_klayoutclaw")
        if cb and cb.on_request:
            cb.on_request(method, datetime.datetime.now().strftime("%H:%M:%S"), success, error_msg)
    except Exception:
        pass


# ---------------------------------------------------------------------------
# Layout state
# ---------------------------------------------------------------------------

_layout_view = None
_layout = None
_top_cell = None
_exec_seq = 0


def _get_or_create_view():
    global _layout_view, _layout, _top_cell
    mw = pya.Application.instance().main_window()
    if mw is None:
        raise ValueError("KLayout main window not available")
    if mw.views() == 0:
        mw.create_layout(0)
    _layout_view = mw.current_view()
    if _layout_view is None:
        raise ValueError("No layout view available")
    cv = _layout_view.active_cellview()
    if cv is None or not cv.is_valid():
        mw.create_layout(0)
        _layout_view = mw.current_view()
        cv = _layout_view.active_cellview()
    _layout = cv.layout()
    if _layout.cells() == 0:
        _top_cell = _layout.create_cell("TOP")
    else:
        _top_cell = _layout.top_cell()
    return _layout_view, _layout, _top_cell


def _handles_stale():
    """Return True if cached _layout/_layout_view/_top_cell are stale."""
    global _layout_view, _layout, _top_cell
    if _layout is None or _layout_view is None or _top_cell is None:
        return True
    try:
        # Tab-switch awareness: if the user (or a prior tool) switched
        # the active view, the cached _layout_view is still alive but
        # no longer the GUI's current tab. Subsequent tools (route_inspect,
        # screenshot, evaluate_design ...) would otherwise quietly operate
        # on the prior tab. Treat that as stale so the next
        # `_ensure_valid_handles()` re-acquires from `mw.current_view()`.
        mw = pya.MainWindow.instance()
        if mw is not None and _layout_view is not mw.current_view():
            return True
        # Verify layout is still alive
        _layout.cells()
        # Verify the cellview is still valid
        cv = _layout_view.active_cellview()
        if cv is None or not cv.is_valid():
            return True
        # Verify cached layout matches the current view's layout
        if cv.layout() is not _layout:
            return True
        _top_cell.name
    except Exception:
        return True
    return False


def _ensure_valid_handles():
    """Refresh layout handles if they are stale."""
    if _handles_stale():
        _get_or_create_view()


# ---------------------------------------------------------------------------
# execute_script protection: pre/post snapshot + damage recovery
#
# `_layout` exposed to user scripts is a direct alias of the active
# cellview's layout (see `_get_or_create_view`). Destructive ops in user
# code (`_layout.clear()`, `_layout.assign(...)`, `_layout.read(...)`)
# leave dangling pya handles inside both the user script (the script's
# own captures) and the GUI's `cv.cell` pointer. The GUI's next paint
# dereferences the dangling pointer and segfaults the whole process.
#
# These helpers snapshot the live state before exec(), then probe each
# handle individually after exec(), rebinding any that became invalid
# and emitting an explicit, agent-visible report (never silent) of what
# the server repaired and why.
# ---------------------------------------------------------------------------


def _snapshot_layout_state():
    """Capture identifying tokens for the live layout/view state before
    execute_script runs, so post-exec damage can be detected and named."""
    snap = {
        "had_layout": _layout is not None,
        "had_view": _layout_view is not None,
        "pre_cells": None,
        "top_cell_name": None,
        "cv_cell_name": None,
    }
    if _layout is not None:
        try:
            snap["pre_cells"] = _layout.cells()
        except Exception:
            snap["pre_cells"] = None
    if _top_cell is not None:
        try:
            snap["top_cell_name"] = _top_cell.name
        except Exception:
            snap["top_cell_name"] = None
    if _layout_view is not None:
        try:
            cv = _layout_view.active_cellview()
            if cv is not None and cv.is_valid() and cv.cell is not None:
                snap["cv_cell_name"] = cv.cell.name
        except Exception:
            snap["cv_cell_name"] = None
    return snap


def _post_exec_revalidate(pre):
    """Detect destroyed/dangling pya handles after exec() and rebind them
    to safe values before control returns to Qt's event loop. Returns a
    list of human-readable dicts -- one per protective action -- so the
    agent sees exactly what the server changed and why. Never silent.
    """
    global _layout, _layout_view, _top_cell
    actions = []

    # 1. Verify _layout itself is alive.
    layout_alive = False
    if _layout is not None:
        try:
            _layout.cells()
            layout_alive = True
        except Exception:
            layout_alive = False

    if not layout_alive:
        old_pre = pre.get("pre_cells")
        actions.append({
            "trigger": "_layout reference is invalid after script (None or destroyed). pre_cells={}".format(old_pre),
            "action": "Re-acquired _layout via _get_or_create_view(); a fresh tab/layout was used if necessary.",
            "guidance": "Do not None-out or destroy _layout. Use a detached pya.Layout() for scratch work, or cv.layout() for a local read-only handle.",
        })
        try:
            _get_or_create_view()
        except Exception as _re:
            actions.append({
                "trigger": "_layout re-acquisition failed",
                "action": "No recovery possible; subsequent tools may fail",
                "error": str(_re),
            })
            try:
                _log("execute_script: layout recovery failed: {}".format(_re))
            except Exception:
                pass
        if actions:
            try:
                _log("execute_script: {} protective action(s) applied (layout rebuild)".format(len(actions)))
            except Exception:
                pass
        return actions

    # 2. Detect mass cell destruction (e.g. _layout.clear()).
    pre_cells = pre.get("pre_cells")
    try:
        post_cells = _layout.cells()
    except Exception:
        post_cells = None
    if pre_cells is not None and post_cells == 0 and pre_cells > 0:
        actions.append({
            "trigger": "Active layout was emptied during script (cells: {} -&gt; 0). Likely _layout.clear() / .assign() / .read() on the live view layout.".format(pre_cells),
            "action": "No data recovery is possible. Any pya.Cell, pya.Shapes, or pya.Region handles your script captured before the destructive call are now dangling and will raise 'Object has been destroyed already'.",
            "guidance": "_layout IS the active cellview's layout, not a scratch buffer. For temporary work use pya.Layout() (detached). To replace the visible layout safely, call create_layout (new tab) instead of clear()+assign().",
        })

    # 3. Verify _top_cell handle.
    top_cell_alive = False
    if _top_cell is not None:
        try:
            _ = _top_cell.name
            top_cell_alive = True
        except Exception:
            top_cell_alive = False

    top_cell_was_recreated = False
    if not top_cell_alive:
        old_name = pre.get("top_cell_name")
        try:
            if _layout.cells() == 0:
                _top_cell = _layout.create_cell("TOP")
                top_cell_was_recreated = True
                actions.append({
                    "trigger": "_top_cell handle was destroyed and layout is empty (previous top: {!r}).".format(old_name),
                    "action": "Created a fresh placeholder cell named 'TOP' so the cellview can paint.",
                    "guidance": "Re-create geometry on this cell, or call create_layout to start a clean tab.",
                })
            else:
                _top_cell = _layout.top_cell()
                top_cell_was_recreated = True
                try:
                    _new_name = _top_cell.name
                except Exception:
                    _new_name = "unknown"
                actions.append({
                    "trigger": "_top_cell handle was destroyed but layout still contains cells (previous top: {!r}).".format(old_name),
                    "action": "Rebound _top_cell to current layout.top_cell() = {!r}.".format(_new_name),
                    "guidance": "If you need a specific cell, retrieve it by name from _layout after destructive operations.",
                })
        except Exception as _re:
            actions.append({
                "trigger": "_top_cell rebinding failed",
                "action": "No recovery possible; subsequent tools may fail",
                "error": str(_re),
            })

    # 4. Verify the active cellview's `cell` pointer (the GUI-crash hazard).
    # Logic: a "dangling" cv.cell is one that (a) was a valid named cell at
    # pre-snapshot time but is no longer reachable via .name, OR (b) we just
    # recreated _top_cell in step 3 -- because pya's Python `cv.cell` wrapper
    # may auto-rebind silently while KLayout's C++ cv->cell pointer remains
    # stale (Qt paints will then dereference garbage and either segfault or
    # hang the GUI). We therefore force-rebind whenever step 3 fired, not
    # just when we can prove cv.cell is None/dead.
    # A cv.cell of None on a freshly-created view (when the snapshot also
    # had None and step 3 did NOT rebuild _top_cell) is not dangerous and
    # must not be reported.
    pre_had_cv_cell = pre.get("cv_cell_name") is not None
    if _layout_view is not None:
        try:
            cv = _layout_view.active_cellview()
        except Exception:
            cv = None
        if cv is not None:
            try:
                cv_valid = cv.is_valid()
            except Exception:
                cv_valid = False
            if cv_valid:
                cv_cell_ok = False
                try:
                    if cv.cell is not None:
                        _ = cv.cell.name
                        cv_cell_ok = True
                    else:
                        # cv.cell is None: only OK if it was None before too.
                        cv_cell_ok = not pre_had_cv_cell
                except Exception:
                    cv_cell_ok = False
                # Force a rebind whenever we recreated _top_cell, even if
                # cv.cell looks valid -- the Python wrapper can be auto-rebound
                # by pya while the underlying C++ cv->cell still points at
                # destroyed memory, causing Qt to hang on next paint.
                if top_cell_was_recreated:
                    cv_cell_ok = False
                if not cv_cell_ok:
                    old = pre.get("cv_cell_name")
                    try:
                        if _top_cell is not None:
                            cv.cell = _top_cell
                        else:
                            cv.cell = _layout.top_cell()
                        try:
                            _new_name = cv.cell.name
                        except Exception:
                            _new_name = "unknown"
                        if top_cell_was_recreated:
                            _trig = ("Active cellview's cv.cell may reference C++-stale memory "
                                     "after _top_cell was rebuilt (previous: {!r}). Force-rebinding "
                                     "preemptively to keep Qt's next paint safe.").format(old)
                        else:
                            _trig = ("Active cellview's cv.cell pointer was dangling after script "
                                     "(previous: {!r}). This is the KLayout GUI segfault trigger.").format(old)
                        actions.append({
                            "trigger": _trig,
                            "action": "Rebound cv.cell to {!r} before returning to Qt's event loop.".format(_new_name),
                            "guidance": "After _layout.clear() / .assign() / .read() you MUST rebind cv.cell. The server did this for you; consider operating on a detached pya.Layout() and using create_layout to swap views explicitly.",
                        })
                    except Exception as _re:
                        actions.append({
                            "trigger": "cv.cell rebinding failed",
                            "action": "Could not rebind cv.cell -- KLayout may crash on next repaint",
                            "error": str(_re),
                        })

    # Mirror a one-line summary into the KLayout log so users with the
    # console open see protection events without parsing the JSON.
    if actions:
        try:
            _log("execute_script: {} protective action(s) applied".format(len(actions)))
            for _a in actions:
                _log("  - {}".format(_a.get("trigger", "?")))
        except Exception:
            pass

    return actions


# ---------------------------------------------------------------------------
# Session management
# ---------------------------------------------------------------------------

_session_id = None


def _ensure_session():
    global _session_id
    if _session_id is None:
        _session_id = str(uuid.uuid4())
    return _session_id


# ---------------------------------------------------------------------------
# Tool definitions
# ---------------------------------------------------------------------------

TOOLS = [
    {
        "name": "create_layout",
        "description": "Create a new layout with a top cell. Returns the cell name.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "name": {"type": "string", "description": "Top cell name", "default": "TOP"},
                "dbu": {"type": "number", "description": "Database unit in microns", "default": 0.001}
            }
        }
    },
    {
        "name": "execute_script",
        "description": "Execute arbitrary Python/pya code in KLayout. The namespace includes: pya, json, os, _layout, _layout_view, _top_cell, _get_or_create_view() (returns tuple: _layout_view, _layout, _top_cell), _refresh_view(). Set the variable 'result' to return data (will be serialized as JSON). The view is refreshed automatically after execution.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "code": {"type": "string", "description": "Python code to execute"}
            },
            "required": ["code"]
        }
    },
